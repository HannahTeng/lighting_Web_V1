# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Never commit real keys (see AGENTS.md).
# ─────────────────────────────────────────────────────────────

# Neon Postgres connection string
DATABASE_URL=your_neon_connection_string_here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public app URL (used for Stripe redirect URLs and product image absolute paths)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin backend auth
# ADMIN_PASSWORD       — the password for /admin login
# ADMIN_SESSION_SECRET — a long random string used to sign the session cookie
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string
